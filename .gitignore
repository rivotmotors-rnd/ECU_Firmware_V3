# =============================================================================

**/Debug/
**/Release/
**/.settings/
**/.cproject
**/.project.bak
**/.metadata/
**/*.d
**/*.o
**/*.a
**/*.elf
**/*.bin
**/*.hex
**/*.map
**/*.lst
**/*.su

# =============================================================================
# 2. PlatformIO Build Artifacts (ESP32)
# =============================================================================
**/.pio/
**/.pioenvs/
**/pioenvs/

# =============================================================================
# 3. Reference Documents & Internal Design Files
# =============================================================================
**/Documents/
# =============================================================================
# 2. KiCad / Hardware EDA Artifacts
# =============================================================================
**/__pycache__/
**/fp-info-cache
**/gerbers/
**/fab/
**/*-backups/
**/*.kicad_prl
**/*.pro.bak
**/*.sch-bak
**/*.kicad_sch-bak
**/*.kicad_pcb-bak
**/~*.lck
**/*.000
**/*.001
**/*.gbr
**/*.drl
**/*.gbl
**/*.gbs
**/*.gbo
**/*.gbp
**/*.gtl
**/*.gts
**/*.gto
**/*.gtp

# =============================================================================
